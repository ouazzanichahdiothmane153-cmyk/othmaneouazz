# Port HTTP du serveur
PORT=3000

# Jeton admin : requis pour le tableau de bord et l'API (/api/*)
# Générez-en un : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=change-me

# Fichier SQLite (la base de données du client)
DB_FILE=./data/app.sqlite

# Indicatif pays par défaut pour les numéros locaux (ex. 212 pour le Maroc, 33 pour la France)
DEFAULT_COUNTRY_CODE=212

# --- WhatsApp Cloud API (Meta) ---
# Laisser WHATSAPP_TOKEN vide = mode simulation (rien n'est envoyé, tout est journalisé)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Jeton de vérification du webhook (à saisir dans la console Meta)
WHATSAPP_VERIFY_TOKEN=change-me-too
# Secret de l'application Meta : sert à vérifier la signature des webhooks
WHATSAPP_APP_SECRET=

# --- Worker d'envoi ---
WORKER_INTERVAL_MS=5000
SEND_DELAY_MS=1000
MAX_ATTEMPTS=3
